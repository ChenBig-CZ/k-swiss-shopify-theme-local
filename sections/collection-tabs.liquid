{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

<script src="{{ 'siblings-plp.js' | asset_url }}" defer></script>

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% assign show_siblings = false %}
{% if settings.show_siblings_plp and section.settings.show_siblings %}
  {% assign show_siblings = true %}
{% endif %}
{% assign show_siblings_count = settings.show_siblings_count_plp %}

{%- style -%}
  .tab-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .tab-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%  if section.blocks.size > 0 %}
  <div class="tabs-section color-{{ section.settings.color_scheme }} isolate gradient tab-{{ section.id }}">
    <link rel="stylesheet" href="//code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="//code.jquery.com/jquery-3.6.0.js"></script>
    <script src="//code.jquery.com/ui/1.13.2/jquery-ui.js"></script>
    {%  if section.settings.useslider %}
      <script src="//cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
    
    <link rel="stylesheet" type="text/css" href="//cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css"/>
    <link rel="stylesheet" type="text/css" href="//cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick-theme.min.css"/>
    {%  endif %}
    <div class="section-{{ section.id }}-padding page-width--narrow">

    <div id="tabs-{{ section.id }}" class="tabs">

      <div class="tab_header">
      {%- if section.settings.title != blank -%}
        <h2 class="m-0 inline-richtext h1 scroll-trigger animate--slide-in">
            {{ section.settings.title }}
        </h2>
        {%- endif -%}

      {%  assign tabContent = '' %}
      <ul class="tab-box">
      {%  for block in section.blocks %}
        {%  assign collection = collections[block.settings.collection] %}
        <li class="collection-switcher-img">
          <a href="#tabs-{{ collection.id }}">
            {% if block.settings.tab_txt != blank %}
              <p>{{ block.settings.tab_txt  }}</p>
            {% else %}
            <p>{{ collection.title  }}</p>
            {% endif %}
          </a>
        </li>
      {% endfor %}
      </ul>
    </div>
      
        
        {%  for block in section.blocks %}
       {%  assign collection = collections[block.settings.collection] %}
        {%  capture content  %}
            <div id="tabs-{{ collection.id }}">
              <ul class="grid product-grid grid--2-col-tablet-down  grid--4-col-desktop">
               {%- for product in block.settings.collection.products limit: 20 -%}
               <li class="grid__item scroll-trigger ">
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    show_quick_add: section.settings.enable_quick_add,
                    section_id: section.id,
                    show_siblings: show_siblings,
                    show_siblings_count: show_siblings_count,
                    number: forloop.index
                  %}
               </li>
              {%- endfor -%}
              </ul>
             {%  if block.settings.viewall %}
               <div class="center collection__view-all scroll-trigger animate--slide-in">
                 <a class="button" href="{{ block.settings.collection.url }}"> SEE MORE </a>
               </div>
               {%  endif  %}
            </div>
        {%  endcapture %}
        {%  assign tabContent = tabContent | append: content %}
      {%  endfor %}  
      {{ tabContent }}
    </div>  
    </div>
  </div> 
    <script>
  $( function() {
    {%  if section.settings.useslider %}
    function tabSlider(){
          $('.tabs .product-grid.slick-initialized ').slick('unslick');
          $('.tabs .product-grid ').slick({
            dots: false,
            arrows: true,
            infinite: false,
            speed: 300,
            slidesToShow: 5,
            slidesToScroll: 1,
            prevArrow: `
            <button type="button" class="splide__arrow splide__arrow--prev" aria-label="Previous slide">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="32" height="32">
                <path d="m24.5 0.932 4.3 4.38-14.5 14.6 14.5 14.5-4.3 4.4-14.6-14.6-4.4-4.3 4.4-4.4 14.6-14.6z"></path>
              </svg>
            </button>
          `,
          nextArrow: `
            <button type="button" class="splide__arrow splide__arrow--next" aria-label="Next slide">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="32" height="32">
                <path d="m15.5 0.932-4.3 4.38 14.5 14.6-14.5 14.5 4.3 4.4 14.6-14.6 4.4-4.3-4.4-4.4-14.6-14.6z"></path>
              </svg>
            </button>
          `,
            responsive: [
              {
                breakpoint: 1024,
                settings: {
                  slidesToShow: 3,
                  slidesToScroll: 1,
                  infinite: true
                }
              },
              {
                breakpoint: 600,
                settings: {
                  slidesToShow: 2,
                  slidesToScroll: 1
                }
              },
              {
                breakpoint: 480,
                settings: {
                  slidesToShow: 1,
                  slidesToScroll: 1
                }
              }
            
            ]
          });
    }
        {%  endif %}


    $("#tabs-{{ section.id }}").tabs({
  create: function () {
    $('.tabs-section').addClass('is-loaded');
    {% if section.settings.useslider %}
      tabSlider();
    {% endif %}
  },
  activate: function( event, ui ) {
        {%  if section.settings.useslider %}
       tabSlider()
            {%  endif %}
      }
});

  
  } );
  
  </script>

  <style>
    /* ----------------------------
   SPLIDE ARROWS
----------------------------- */
.tab-{{ section.id }} .splide__arrow {
  position: absolute;
  z-index: 2;
  top: 50%;
  transform: translateY(-100%);
  width: 40px;
  height: 40px;
  border-radius: 50%;
  padding: 0;
  background: #fff;
  border: 1px solid transparent;
  box-shadow: 0 0 8px rgba(0, 0, 0, 0.15);
  cursor: pointer;
  transition: all 0.3s ease;
  opacity: 0.9;
}
.tab-{{ section.id }} .splide__arrow svg {
  fill: #000;
  width: 0.8em;
  height: 0.8em;
}

.tab-{{ section.id }} .splide__arrow:disabled {
  pointer-events: none;
}
.tab-{{ section.id }} .splide__arrow--prev {
  left: -20px;
}
.tab-{{ section.id }} .splide__arrow--next {
  right: -20px;
}
{% comment %} .tab-{{ section.id }} .tabs-section{
    border: 1px solid #E1E1E1;
  } {% endcomment %}

.tab-{{ section.id }} .tab_header{
  padding-bottom: 2.5rem;
    padding-top: 48px;
  padding-left: 4rem;
    padding-right: 4rem;
    border-width: 0px,1px,0px,1px;
    border-color: #e1e1e1;
    {% comment %} border-left: 1px solid #E1E1E1; {% endcomment %}
    {% comment %} border-right: 1px solid #E1E1E1; {% endcomment %}
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

    .tab-{{ section.id }} .tab_header h2{
    margin: 0px;
  }
  .tab-{{ section.id }} .ui-tabs .ui-tabs-panel{
        border-color: #e1e1e1;
    {% comment %} border-left: 1px solid #E1E1E1; {% endcomment %}
    {% comment %} border-right: 1px solid #E1E1E1; {% endcomment %}
    padding: 0px;
  }
  .tab-{{ section.id }} .grid__item{
    padding: 5px;
            {% comment %} border-left: 1px solid #e1e1e1; {% endcomment %}
  }
  .tab-{{ section.id }} .product-grid{
    margin: 0px;
       {% comment %} border: 1px solid #e1e1e1; {% endcomment %}
        border-bottom: 0;
    border-left: 0;
  }
    .tab-{{ section.id }} .tabs .slick-next::before,.tab-{{ section.id }} .tabs .slick-prev::before { color: #000;}
    .tab-{{ section.id }} .tabs { background: none!important;border: none!important; padding: 0px;}
    .tab-{{ section.id }} .tabs.ui-tabs .ui-tabs-nav {
    background: #fff;
    border: 1px solid #0000001A;
    border-radius: 40px;
    padding: 4px;
    display: flex;
    }
.tab-{{ section.id }} .ui-state-default, .tab-{{ section.id }} .ui-widget-content .ui-state-default, .tab-{{ section.id }} .ui-widget-header .ui-state-default{
    background: #fff;
    border-radius: 40px;
    font-weight: 600;
    font-size: 14px;
    text-align: center;
    text-transform: uppercase;
    min-width: 90px;
    cursor: pointer;
    border: none;
    margin: 0 !important;
}
   .tab-{{ section.id }} .ui-tabs .ui-tabs-nav li a{
        width: 100%;
        padding: 0.7em 1em !important;
            font-family: var(--font-body-family);
  }
.tab-{{ section.id }}  .tab_box li{
background: #000;
    color: #fff;
}
.tab-{{ section.id }} .ui-tabs .ui-tabs-nav li.ui-tabs-active{
  background: #000;
  color: #fff;
}

@media (min-width: 320px) and (max-width: 480px) {
  .tab-{{ section.id }} .splide__arrow--prev {
    left: 5px;
  }
  .tab-{{ section.id }} .splide__arrow--next {
    right: 5px;
  }
  .tab-{{ section.id }} .tab_header{
    flex-direction: column;
  }
}

  </style>
  
  <script>
function equalizeProductHeights(container) {
  let maxHeight = 0;

  $(container + ' .grid__item, ' + container + ' .product-card').css('height', 'auto');

  $(container + ' .grid__item, ' + container + ' .product-card').each(function() {
    let thisHeight = $(this).outerHeight();
    if (thisHeight > maxHeight) maxHeight = thisHeight;
  });

  $(container + ' .grid__item, ' + container + ' .product-card').css('height', maxHeight + 'px');
}

$(window).on('load resize', function() {
  equalizeProductHeights('.tabs .product-grid');
});

$('.tabs .product-grid').on('setPosition', function() {
  equalizeProductHeights('.tabs .product-grid');
});
</script>

{%  endif %}  
{% schema %}
  {
    "name": "Collection Tabs",
    "class": "collection_tabs",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      },
       {
        "type": "checkbox",
        "id": "useslider",
        "label": "Use slider",
        "default": true
      },
      {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.featured-collection.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.featured-collection.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.featured-collection.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.featured-collection.settings.image_ratio.label"
    },
      {
        "type": "checkbox",
        "id": "show_secondary_image",
        "default": false,
        "label": "t:sections.featured-collection.settings.show_secondary_image.label"
        },
        {
        "type": "checkbox",
        "id": "show_vendor",
        "default": false,
        "label": "t:sections.featured-collection.settings.show_vendor.label"
        },
        {
        "type": "checkbox",
        "id": "show_rating",
        "default": false,
        "label": "t:sections.featured-collection.settings.show_rating.label",
        "info": "t:sections.featured-collection.settings.show_rating.info"
        },
        {
          "type": "checkbox",
          "label": "Show Siblings",
          "id": "show_siblings",
          "default": false
        },
        {
            "type": "select",
            "id": "quick_add",
            "default": "none",
            "label": "t:sections.main-collection-product-grid.settings.quick_add.label",
            "options": [
                {
                "value": "none",
                "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_1"
                },
                {
                "value": "standard",
                "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_2"
                },
                {
                "value": "bulk",
                "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_3"
                }
            ]
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.all.colors.label",
            "info": "t:sections.all.colors.has_cards_info",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "t:sections.all.padding.section_padding_heading"
            },
            {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_top",
            "default": 36
            },
            {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_bottom",
            "default": 36
            }
    ],
    "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 15,
    
    "settings": [
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      },
      {
        "type": "text",
        "id": "tab_txt",
        "label": "Tab label"
      },
      {
        "type": "checkbox",
        "id": "viewall",
        "label": "Show view all",
        "default": true
      }
    ]
  
    }
  ],
    "presets": [
    {
      "name": "Collection Tabs",
      "blocks": []
    }
  ]
  }
{% endschema %}