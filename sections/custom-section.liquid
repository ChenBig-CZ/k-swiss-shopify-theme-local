{%- style -%}
  .custom-flex-grid-{{ section.id }} {
    display: grid;
    gap: var(--grid-desktop-horizontal-spacing);
  }

  @media (min-width: 750px) {
    .custom-flex-grid-{{ section.id }} {
      grid-template-columns: var(--desktop-columns);
    }
  }

  .custom-flex-grid__item {
    width: 100%;
  }

  .custom-flex-grid__media img,
  .custom-flex-grid__media video,
  .custom-flex-grid__media iframe {
    width: 100%;
    height: auto;
    display: block;
  }
{%- endstyle -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="multicolumn gradient color-{{ section.settings.color_scheme }} {% unless section.settings.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} background-{{ section.settings.background_style }}{% endunless %}{% if section.settings.title == blank %} no-heading{% endif %} {% if section.settings.hide_mobile %}small-hide{% endif %} {% if section.settings.hide_tablet %}medium-hide{% endif %} {% if section.settings.hide_desktop %}large-up-hide{% endif %}" id="{{ section.settings.section_id }}">
    <div
    class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >

    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
        {%- if section.settings.button_label != blank and show_mobile_slider -%}
          <a href="{{ section.settings.button_link }}" class="link underlined-link large-up-hide">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}

  <div
    class="custom-flex-grid-{{ section.id }}"
    style="
      --desktop-columns:
      {% for block in section.blocks %}
        {{ block.settings.width_desktop }}%{% unless forloop.last %} {% endunless %}
      {% endfor %};

      --mobile-columns:
      {% for block in section.blocks %}
        {{ block.settings.width_mobile }}%{% unless forloop.last %} {% endunless %}
      {% endfor %};
    "
  >
    {% for block in section.blocks %}
      <div
        class="custom-flex-grid__item"
        {{ block.shopify_attributes }}
      >
        {% case block.type %}

          {% when 'image' %}
            {% if block.settings.image != blank %}
              <div class="custom-flex-grid__media">
                {% if block.settings.image_link != blank %}
                  <a href="{{ block.settings.image_link }}">
                {% endif %}

                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                >

                {% if block.settings.image_link != blank %}
                  </a>
                {% endif %}
              </div>
            {% endif %}

          {% when 'text' %}
            <div class="custom-flex-grid__content">
              {% if block.settings.title != blank %}
                <h2>{{ block.settings.title }}</h2>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="rte">{{ block.settings.text }}</div>
              {% endif %}
              {% if block.settings.button_label != blank %}
                <a
                  class="button button--primary"
                  href="{{ block.settings.button_link }}"
                >
                  {{ block.settings.button_label }}
                </a>
              {% endif %}
            </div>

          {% when 'video' %}
            <div class="custom-flex-grid__media">
              {% if block.settings.video_url != blank %}
                {{ block.settings.video_url | video_tag: controls: true, autoplay: false }}
              {% endif %}
            </div>

        {% endcase %}
      </div>
    {% endfor %}
  </div>
</div>
</div>

{% schema %}
{
  "name": "Custom Flex Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Responsive"
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "default": false,
      "label": "Hide on Mobile"
    },
    {
      "type": "checkbox",
      "id": "hide_tablet",
      "default": false,
      "label": "Hide on Tablet"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "default": false,
      "label": "Hide on Desktop"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.multicolumn.settings.title.default",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "url",
          "id": "image_link",
          "label": "Image link"
        },
        {
          "type": "select",
          "id": "width_desktop",
          "label": "Width (Desktop)",
          "default": "50",
          "options": [
            { "value": "25", "label": "25%" },
            { "value": "33", "label": "33%" },
            { "value": "50", "label": "50%" },
            { "value": "66", "label": "66%" },
            { "value": "100", "label": "100%" }
          ]
        },
        {
          "type": "select",
          "id": "width_mobile",
          "label": "Width (Mobile)",
          "default": "100",
          "options": [
            { "value": "50", "label": "50%" },
            { "value": "100", "label": "100%" }
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "inline_richtext", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        {
          "type": "select",
          "id": "width_desktop",
          "label": "Width (Desktop)",
          "default": "50",
          "options": [
            { "value": "25", "label": "25%" },
            { "value": "33", "label": "33%" },
            { "value": "50", "label": "50%" },
            { "value": "66", "label": "66%" },
            { "value": "100", "label": "100%" }
          ]
        },
        {
          "type": "select",
          "id": "width_mobile",
          "label": "Width (Mobile)",
          "default": "100",
          "options": [
            { "value": "50", "label": "50%" },
            { "value": "100", "label": "100%" }
          ]
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video_url", "label": "Video" },
        {
          "type": "select",
          "id": "width_desktop",
          "label": "Width (Desktop)",
          "default": "100",
          "options": [
            { "value": "50", "label": "50%" },
            { "value": "66", "label": "66%" },
            { "value": "100", "label": "100%" }
          ]
        },
        {
          "type": "select",
          "id": "width_mobile",
          "label": "Width (Mobile)",
          "default": "100",
          "options": [
            { "value": "100", "label": "100%" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Flex Grid",
      "blocks": [
        { "type": "image" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
