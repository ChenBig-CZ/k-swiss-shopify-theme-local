<script>
document.addEventListener('DOMContentLoaded', () => {
  const bisBtn = document.getElementById('KlaviyoBIS');
  if (!bisBtn || !window.product || !window.product.variants) return;

  const variants = window.product.variants;

  const hasVariantParam = new URLSearchParams(window.location.search).has('variant');
  let userInteracted = hasVariantParam; // variant URL = treated as interaction

  function allVariantsOutOfStock() {
    return variants.every(v => v.available === false);
  }

  function selectedVariantOutOfStock() {
    const input = document.querySelector('input.product-variant-id');
    if (!input) return false;

    const variant = variants.find(v => v.id == input.value);
    return variant ? variant.available === false : false;
  }

  function updateNotifyVisibility() {
    let showNotify = false;

    if (!userInteracted) {
      // ✅ DEFAULT PAGE LOAD LOGIC
      showNotify = allVariantsOutOfStock();
    } else {
      // ✅ USER VARIANT CHANGE LOGIC
      showNotify = selectedVariantOutOfStock();
    }

    bisBtn.style.setProperty(
      'display',
      showNotify ? 'block' : 'none',
      'important'
    );
  }

  // Initial run
  updateNotifyVisibility();

  // When user changes variant
  document.addEventListener('variant:change', () => {
    userInteracted = true;
    updateNotifyVisibility();
  });

  // Klaviyo async safety
  setTimeout(updateNotifyVisibility, 300);
  setTimeout(updateNotifyVisibility, 1000);
  setTimeout(updateNotifyVisibility, 2000);
});
</script>
