        "heading_7bppbN": {
          "type": "heading",
          "settings": {
            "heading": "Meet Jeremy Davis – Founder of Manor",
            "heading_size": "h1"
          }
        },
        "text_khwVnp": {
          "type": "text",
          "settings": {
            "text": "<p>​​Inspired by childhood memories of his father’s K-Swiss sneakers — white leather classics dusted with green specks from mowing the lawn — the collection carries forward a generational story. “I remember an instance when going on a family vacation, when my dad had to pick up some shoes at the Sands Hotel Tennis ProShop,” Davis recalls. “He returned to the car with two brand-new identical pairs of K-Swiss Classics, and that’s when he shared his philosophy of always having a clean pair ready to go. I wear K-Swiss because my dad did.”</p>",
            "text_style": "body"
          }
        }
      },
