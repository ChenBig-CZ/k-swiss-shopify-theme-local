<style>
i.icon-swym-wishlist {
    font-family: 'swym-font';
    font-style: normal;
    vertical-align: middle;
}
i.icon-swym-wishlist+span {
    vertical-align: middle;
}
i.icon-swym-wishlist:after {
    content: '';
    font-size: 130%;
    line-height: 18px;
    text-align: center;
    display: inline;
}
/*content rendered after swym is ready to avoid showing block/invalid chars*/
.swym-ready i.icon-swym-wishlist:after {
    content: '\f004';
}
.swym-storefront-layout-grid-item-image-container{
    justify-content: center;
}
    i.icon-swym-wishlist:after {  
    visibility: hidden;
}
.swym-ready i.icon-swym-wishlist:after {  
    visibility: visible;
    content: '\f004'; /* Example content, adjust as needed */
}

#custom-wishlist-button.swym-added .wishlist-icon {
    fill: red; 
}
#custom-wishlist-button {
    background: unset !important;
    display: flex;
    align-items: center;
    column-gap: 10px;
    justify-content: center;
    border: 1px solid #e5e5e5;
    min-width: 150px;
    text-transform: capitalize;
    font-size: 1.5rem;
    font-weight: bold;
}
#custom-wishlist-button.disabled{
    cursor: pointer;
}

.swym-add-to-wishlist{
    background: transparent;
    color: rgba(var(--color-foreground));
    transition: all .2s ease-out;
}
button.swym-button.disabled, button.swym-button:disabled {
    opacity: 1;
}

</style>
<button id="custom-wishlist-button" class="swym-button swym-add-to-wishlist button"
    data-with-epi="true" 
    data-swaction="addToWishlist" 
    data-product-id="{{ product.id }}" 
    data-variant-id="{{ product.variants[0].id }}" 
    data-product-url="{{ shop.url }}{{ product.url }}" 
>
    <svg 
        class="wishlist-icon" 
        aria-hidden="true"
        focusable="false" 
        role="presentation" 
        viewBox="0 0 24 24"
        width="24px"
    >
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
    </svg> Wishlist
</button>