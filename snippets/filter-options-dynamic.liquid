{% liquid
  assign find_replace = filter.find_replace | newline_to_br | split: '<br />'
  assign dynamic_group_values = ''

  for tag in collection.all_tags
    assign matchtag = tag | downcase
    assign matchinc = filter.inclusion | downcase

    if matchtag contains matchinc
      assign dynamic_group_values = dynamic_group_values | append: tag | append: '|'
    endif
  endfor

  for tag in collection.all_tags
    assign matchtag = tag | downcase
    assign matchinc = filter.inclusion | downcase

    if matchtag contains matchinc
      assign field = set.field

      assign key = ''
      assign valuearray = tag | split: filter.delimiter
      assign valueindex = filter.display | minus: 1
      assign label = valuearray[valueindex] | append: ''

      for fr in find_replace
        assign find = fr | split: ':'
        assign label = label | replace: find[0], find[1]
      endfor

      render 'collection-filters-option', collection: collection, set: set.title, format: set.format, value: tag, field: field, key: key, units: set.units, group_values: dynamic_group_values, label: label
    endif
  endfor
%}
